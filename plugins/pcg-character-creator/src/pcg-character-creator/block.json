{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/pcg-character-creator",
	"version": "0.1.0",
	"title": "PCG Character Creator",
	"category": "widgets",
	"icon": "admin-users",
	"description": "A character creator block for Pickle Chip Games",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "pcg-character-creator",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		},
		"age": {
			"type": "string",
			"default": ""
		},
		"pronouns": {
			"type": "string",
			"default": ""
		},
		"backstory": {
			"type": "string",
			"default": ""
		},
		"trait1": {
			"type": "string",
			"default": ""
		},
		"desc1": {
			"type": "string",
			"default": ""
		},
		"trait2": {
			"type": "string",
			"default": ""
		},
		"desc2": {
			"type": "string",
			"default": ""
		},
		"portrait": {
			"type": "object",
			"default": null
		},
		"gallery": {
			"type": "array",
			"default": []
		},
		"brains": {
			"type": "number",
			"default": 0
		},
		"brainsDie": {
			"type": "string",
			"default": "d4"
		},
		"brawn": {
			"type": "number",
			"default": 0
		},
		"brawnDie": {
			"type": "string",
			"default": "d4"
		},
		"fight": {
			"type": "number",
			"default": 0
		},
		"fightDie": {
			"type": "string",
			"default": "d4"
		},
		"flight": {
			"type": "number",
			"default": 0
		},
		"flightDie": {
			"type": "string",
			"default": "d4"
		},
		"grit": {
			"type": "number",
			"default": 0
		},
		"gritDie": {
			"type": "string",
			"default": "d4"
		},
		"charm": {
			"type": "number",
			"default": 0
		},
		"charmDie": {
			"type": "string",
			"default": "d4"
		}
	}
}
