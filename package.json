{
  "name": "picklechipgames",
  "version": "1.0.0",
  "description": "Pickle Chip Games WordPress Environment",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "plugins:install": "./wp-gutenberg-utils/wpg-utils.sh install",
    "plugins:update": "./wp-gutenberg-utils/wpg-utils.sh update",
    "plugins:build": "./wp-gutenberg-utils/wpg-utils.sh build",
    "plugins:generate-imports": "./wp-gutenberg-utils/wpg-utils.sh generate",
    "plugins:config": "./wp-gutenberg-utils/wpg-utils.sh config",
    "plugins:deploy-prep": "npm run plugins:install && npm run plugins:update && npm run plugins:generate-imports && npm run plugins:build"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.16.0"
  },
  "dependencies": {
    "@wordpress/blocks": "^14.12.0",
    "@wordpress/primitives": "^4.23.0"
  }
}
